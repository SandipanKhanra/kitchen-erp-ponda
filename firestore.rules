rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'sadmin' || getUserData().role == 'sadmin');
    }
    
    function isAdmin(centerId) {
      return isAuthenticated() && (
        isSAdmin() || 
        ((request.auth.token.role == 'admin' || getUserData().role == 'admin') && 
         (request.auth.token.centerId == centerId || getUserData().centerId == centerId))
      );
    }
    
    function isMember(centerId) {
      return isAuthenticated() && (
        isSAdmin() || 
        request.auth.token.centerId == centerId || 
        getUserData().centerId == centerId
      );
    }

    // 1. Centers Collection (Multi-Tenancy)
    // Only SAdmin can create/delete centers. Admins can read active centers.
    match /centers/{centerId} {
      allow read: if isAuthenticated();
      allow create, delete: if isSAdmin();
      allow update: if isSAdmin() || (isAdmin(centerId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'code']));
    }

    // 2. Center Creation Requests
    // Admins can raise requests; only SAdmin can approve or reject
    match /center_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.requestedByAdminId == request.auth.uid);
      allow update, delete: if isSAdmin();
    }

    // 3. User Profiles & RBAC
    // Default role 'user'. Admins can assign roles within their center. SAdmin can manage all.
    match /users/{userId} {
      allow read: if isAuthenticated() && (isSAdmin() || isMember(resource.data.centerId));
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isSAdmin() || (isAdmin(resource.data.centerId) && resource.data.centerId == request.resource.data.centerId);
      allow delete: if isSAdmin();
    }

    // 4. Stock & Ingredients (Multi-Tenant Isolation)
    match /centers/{centerId}/stock/{stockId} {
      allow read: if isMember(centerId);
      allow write: if isMember(centerId); // Stock keeper or admin updates purchases & stock
    }

    // 5. Recipes & Patterns
    match /centers/{centerId}/recipes/{recipeId} {
      allow read: if isMember(centerId);
      allow write: if isAdmin(centerId);
    }

    match /centers/{centerId}/patterns/{patternId} {
      allow read: if isMember(centerId);
      allow write: if isAdmin(centerId); // Only admin can create/edit/delete patterns
    }

    // 6. 15-Day Menus & Maker-Checker Dual Approvals
    match /centers/{centerId}/menus/{menuId} {
      allow read: if isMember(centerId);
      allow create: if isMember(centerId);
      allow update: if isMember(centerId) && (
        // Standard edit: resets to pending_approval
        (request.resource.data.status == 'pending_approval') ||
        // Maker-Checker approval: ONLY an admin DIFFERENT from creator can set to 'approved'!
        (request.resource.data.status == 'approved' && isAdmin(centerId) && resource.data.createdBy != request.auth.uid)
      );
      allow delete: if isAdmin(centerId);
    }

    // 7. Global Vaishnava Calendar Events (Read-only master feed)
    match /vaishnava_calendar/{occasionId} {
      allow read: if true;
      allow write: if isSAdmin();
    }
  }
}
