rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'sadmin' || 
        (hasUserDoc() && getUserData().role == 'sadmin')
      );
    }
    
    function isAdmin(centerId) {
      return isAuthenticated() && (
        isSAdmin() || 
        (request.auth.token.role == 'admin' && request.auth.token.centerId == centerId) ||
        (hasUserDoc() && getUserData().role == 'admin' && getUserData().centerId == centerId)
      );
    }
    
    function isMember(centerId) {
      return isAuthenticated() && (
        isSAdmin() || 
        request.auth.token.centerId == centerId || 
        (hasUserDoc() && getUserData().centerId == centerId)
      );
    }

    // 1. Centers Collection (Multi-Tenancy)
    match /centers/{centerId} {
      allow read: if true;
      allow write: if true;
      
      // Subcollections fallback
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 2. Primary Root Collections: recipe, menu, ingredient (and plural variants)
    match /recipe/{recipeId} {
      allow read, write: if true;
    }
    match /recipes/{recipeId} {
      allow read, write: if true;
    }

    match /menu/{menuId} {
      allow read, write: if true;
    }
    match /menus/{menuId} {
      allow read, write: if true;
    }

    match /ingredient/{ingredientId} {
      allow read, write: if true;
    }
    match /ingredients/{ingredientId} {
      allow read, write: if true;
    }
    match /stock/{stockId} {
      allow read, write: if true;
    }

    match /patterns/{patternId} {
      allow read, write: if true;
    }

    // 3. Center Creation Requests
    match /center_requests/{requestId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. User Profiles & RBAC
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Global Vaishnava Calendar Events
    match /vaishnava_calendar/{occasionId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Audit Logs
    match /audit_logs/{auditId} {
      allow read, write: if true;
    }
  }
}
