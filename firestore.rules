rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // Security Helper Functions
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role != null && request.auth.token.role == 'sadmin') ||
        (hasUserDoc() && getUserData().role == 'sadmin') ||
        (request.auth.token.email != null && request.auth.token.email == 'sadmin@iskcon.org')
      );
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        isSAdmin() ||
        (request.auth.token.role != null && request.auth.token.role == 'admin') ||
        (hasUserDoc() && getUserData().role == 'admin')
      );
    }

    // ==========================================
    // 1. Centers Collection (Multi-Tenancy)
    // ==========================================
    match /centers/{centerId} {
      // Public read so devotees can select their center during sign-up
      allow read: if true;
      // Only Super Admins can create, activate/deactivate, or delete centers
      allow create, update, delete: if isSAdmin();
      
      // Center Subcollections (e.g. legacy fallback)
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // ==========================================
    // 2. Standardized Core Entities
    // ==========================================
    
    // Recipes: authenticated kitchen users only
    match /recipes/{recipeId} {
      allow read, write: if isAuthenticated();
    }

    // Menus: authenticated kitchen users only
    match /menus/{menuId} {
      allow read, write: if isAuthenticated();
    }

    // Ingredients & Stock: authenticated kitchen users only
    match /ingredients/{ingredientId} {
      allow read, write: if isAuthenticated();
    }

    // Meal Patterns: authenticated kitchen users only
    match /patterns/{patternId} {
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // 3. Center Addition Requests (Maker-Checker)
    // ==========================================
    match /center_requests/{requestId} {
      allow read: if isAuthenticated();
      // Only Center Admins or Super Admins can submit requests
      allow create: if isAdmin();
      // Only Super Admin can approve or reject center requests
      allow update, delete: if isSAdmin();
    }

    // ==========================================
    // 4. User Profiles & RBAC (Anti-Privilege-Escalation)
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Users can create their own profile (only as 'user' unless SAdmin)
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        request.resource.data.role == 'user' || isSAdmin()
      );
      // Users can update their own non-role fields; only Admins/SAdmins can change roles
      allow update: if isAuthenticated() && (
        isSAdmin() ||
        (isAdmin() && request.resource.data.role != 'sadmin') ||
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
      );
      // Only SAdmin can delete users
      allow delete: if isSAdmin();
    }

    // ==========================================
    // 5. Global Vaishnava Calendar
    // ==========================================
    match /vaishnava_calendar/{occasionId} {
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // 6. Security Protocol: Immutable Audit Logs
    // ==========================================
    match /audit_logs/{auditId} {
      // Authenticated users can view the audit trail
      allow read: if isAuthenticated();
      // Append-only: Authenticated users can record actions
      allow create: if isAuthenticated();
      // Strict Security Protocol: Audit logs can NEVER be altered or deleted!
      allow update: if false;
      allow delete: if false;
    }

    // ==========================================
    // 7. Session Management (Max 2 Devices, 30-Min TTL)
    // ==========================================
    match /user_sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        (request.auth.token.email != null && resource.data.emailLower == request.auth.token.email.lower()) ||
        isSAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSAdmin());
      allow delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        (request.auth.token.email != null && resource.data.emailLower == request.auth.token.email.lower()) ||
        isSAdmin()
      );
    }
  }
}
